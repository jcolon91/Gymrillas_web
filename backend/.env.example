# GYMRILLAS API — copia a .env (deploy/setup.sh lo hace y rellena DB_* y JWT_SECRET)
NODE_ENV=production
PORT=4000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gymrillas
DB_USER=gymrillas_user
DB_PASS=

# Auth (setup.sh genera un secreto aleatorio)
JWT_SECRET=
JWT_EXPIRES=7d

# Dominio público (CORS y URLs absolutas de imágenes subidas)
CORS_ORIGINS=https://gymrillas.com,https://www.gymrillas.com
PUBLIC_URL=https://gymrillas.com
UPLOAD_DIR=./uploads

# Integraciones (vacías = desactivadas)
ATH_MOVIL_PUBLIC_TOKEN=
ATH_MOVIL_TOKEN=
USPS_USER_ID=
USPS_ORIGIN_ZIP=00725
